# ==============================================================================
# PaisaBridge PK — Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase / PostgREST Database Proxy
# ------------------------------------------------------------------------------
# Base URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
PROXY_BASE_URL=https://your-project-ref.supabase.co

# Supabase service_role / master secret key for backend PostgREST operations
PROXY_MASTER_KEY=your_supabase_service_role_secret_key_here

# Project namespace identifier
PROXY_PROJECT_NAME=paisabridge

# ------------------------------------------------------------------------------
# 2. Cryptography & Security Secrets (Generate using `openssl rand -hex 32`)
# ------------------------------------------------------------------------------
# Secret key used for AES-256-GCM encryption of sensitive data
ENCRYPTION_SECRET=your_32_byte_aes_gcm_hex_secret_here

# Secret key used for signing merchant & admin sessions on Vercel
JWT_SECRET=your_jwt_session_secret_here

# Secret key shared between Vercel and Cloudflare Worker for HMAC-signed internal calls
INTERNAL_SHARED_SECRET=your_internal_shared_secret_here

# ------------------------------------------------------------------------------
# 3. Service Routing URLs
# ------------------------------------------------------------------------------
# Public URL of the Cloudflare Worker API
WORKER_BASE_URL=https://paisabridge-worker.your-subdomain.workers.dev

# Public URL of the Vercel hosted checkout & merchant portal
PUBLIC_CHECKOUT_URL=https://paisabridge.vercel.app/pay

# Toggle low usage mode to conserve database and worker compute limits (true/false)
LOW_USAGE_MODE=false
